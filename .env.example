# Copy to .env and set values as needed.

# --- Optional: Gemini (install with `pip install -e ".[llm]"`) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Optional: MAP-style planner (requires GEMINI_API_KEY for live calls) ---
# APEX_MAP_ENABLED=false
# APEX_MAP_APPLY_PLAN=false
# APEX_MAP_APPLY_REPLAN=false
# APEX_MAP_REPLAN_SHADOW=false
# APEX_MAP_PLAN_SHADOW=false
# APEX_MAP_TIMEOUT_S=60
# APEX_MAP_MAX_RETRIES=2
