# Copy to `.env` in the repo root or your working directory (see apex/config/settings.py
# for load order). Values are optional unless you enable Gemini calls.

# --- Optional: Gemini (install with `pip install -e ".[llm]"`) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- MAP / specialist orchestration (defaults favor MAP on; unset key => baseline only) ---
# APEX_MAP_ENABLED=false
# APEX_MAP_APPLY_PLAN=true
# APEX_MAP_APPLY_REPLAN=true
# APEX_MAP_PLAN_SHADOW=true
# APEX_MAP_REPLAN_SHADOW=true
# APEX_MAP_TIMEOUT_S=60
# APEX_MAP_MAX_RETRIES=2

# --- Telemetry / viewer (see ApexSettings in apex/config/settings.py) ---
# APEX_OBSERVABILITY_ENABLED=true
# APEX_OBSERVABILITY_EMIT_MOVE_STEPS=true
# APEX_VIEWER_PROVENANCE_ENABLED=true
